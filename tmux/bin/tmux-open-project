#!/usr/bin/env bash
set -euo pipefail

opened_only=false
[[ "${1:-}" == "--opened" ]] && opened_only=true

src="$HOME/src"
session_prefix="$(tmux display-message -p '#S')-"
open_windows="$(tmux list-windows -F '#W' 2>/dev/null || true)"

items=()

for gitdir in "$src"/*/.git; do
  [[ -d "$gitdir" ]] || continue

  path="${gitdir%/.git}"
  name="${path##*/}"
  window_name="${session_prefix}${name}"

  if [[ $'\n'"$open_windows"$'\n' == *$'\n'"$window_name"$'\n'* ]]; then
    items+=("* $path")
  elif [[ "$opened_only" == false ]]; then
    items+=("  $path")
  fi
done

project="$(
  printf '%s\n' "${items[@]}" |
    sort -r |
    fzf --no-sort
)"

[[ -z "$project" ]] && exit 0

project="${project:2}"
name="${project##*/}"
window_name="${session_prefix}${name}"

if [[ $'\n'"$open_windows"$'\n' == *$'\n'"$window_name"$'\n'* ]]; then
  tmux select-window -t "$window_name"
  exit 0
fi

tmux new-window -c "$project" -n "$window_name" "emacs -nw ."

tmux split-window -h -c "$project"
tmux split-window -v -c "$project" "ai"
tmux select-pane -U
tmux split-window -v -c "$project"

tmux select-pane -L
