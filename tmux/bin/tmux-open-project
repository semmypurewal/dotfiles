#!/usr/bin/env bash
set -euo pipefail

project="$(
  find "$HOME/src" -maxdepth 3 -type d -name .git 2>/dev/null |
    sed 's#/.git$##' |
    sort |
    fzf
)"

[ -z "$project" ] && exit 0

session="$(tmux display-message -p '#S')"
project_name="$(basename "$project")"
window_name="${session}-${project_name}"

# If this window already exists in the current session, switch to it.
if tmux list-windows -F '#W' | grep -Fxq "$window_name"; then
  tmux select-window -t "$window_name"
  exit 0
fi

# Create editor pane
tmux new-window -c "$project" -n "$window_name" "emacs -nw ."
tmux select-pane -T "editor"

# Create top-right pane
tmux split-window -h -c "$project"
tmux select-pane -T "term 1"

# Create bottom-right pane
tmux split-window -v -p 33 -c "$project" "ai"
tmux select-pane -T "ai container"

# Create middle-right pane
tmux select-pane -U
tmux split-window -v -p 50 -c "$project"
tmux select-pane -T "term 2"

# Return focus to editor
tmux select-pane -L

